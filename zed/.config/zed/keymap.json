// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-shift-q": "text_finder::Toggle"
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      // Allow history navigation in Terminal
      "ctrl-p": null,
      "ctrl-n": null,
      // "escape escape": "terminal::ToggleViMode",
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "ctrl-d": "vim::SelectNext",
      "ctrl-D": "vim::SelectPrevious",
      "shift-s": "vim::PushAddSurrounds", // Surround from visual mode
      "shift-x": "vim::Exchange",  // Exchange regions
      // Neovim 0.13 Visual Q: one cursor per selected line
      "shift-q": [
        "editor::SplitSelectionIntoLines",
        { "keep_selections": false }
      ]
    },
  },
  // {
  //     "context": "vim_operator == a",
  //     "bindings": {
  //         "n": "vim::SelectLargerSyntaxNode", // Select larger syntax node
  //     }
  // },
  // {
  //   "context": "vim_operator == i",
  //   "bindings": {
  //       "n": "vim::SelectSmallerSyntaxNode", // Select smaller syntax node
  //   }
  // },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
        "1 shift-q": "editor::SelectAllMatches"
    }
  },
  {
    "context": "(vim_mode == normal || vim_mode == visual) && multiple_selections && !menu",
    "bindings": {
      // Neovim 0.13 Ctrl-l: clear multicursors
      "ctrl-l": "editor::Cancel",

      // Approximation of Neovim gQ: restore previous cursor set
      "g shift-q": "editor::UndoSelection"
    }
  },
  {
    "context": "(vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
      "g w": "vim::HelixJumpToWord",
      "g O": "outline_panel::ToggleFocus",
    }
  },
  {
    "context": "Editor && !menu",
    "bindings": {
      "ctrl-t": "project_symbols::Toggle",    // vim default: go to older tag
      "ctrl-s": "workspace::Save",            // vim default: show signature
      "alt-o": "editor::SelectLargerSyntaxNode",
      "alt-i": "editor::SelectSmallerSyntaxNode",
    }
  },
  // Navigate between dock windows like normal editor windows
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown"
    }
  },
  // Spacebar bindings
  {
    "context": "(vim_mode == normal || vim_mode == visual || helix_mode == normal || helix_mode == select) && !menu",
    "bindings": {
      "space b": "tab_switcher::ToggleAll",
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "space e": "project_panel::ToggleFocus",
      "space ?": "zed::OpenKeymap",
      "space ;": "command_palette::Toggle",
      "space w": ["workspace::SendKeystrokes", "ctrl-w"]
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "space": "vim::WrappingRight"
    }
  }
]
